{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(npx playwright test*)",
      "Bash(npx playwright show-report*)",
      "Bash(npx playwright install*)",
      "Bash(npm run *)",
      "Bash(npx tsc --noEmit*)"
    ],
    "deny": [
      "Bash(git push* main)",
      "Bash(git push* master)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Read(**/.env*)",
      "Edit(**/.env*)",
      "Write(**/.env*)",
      "Bash(rm -rf*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.auth/**)",
      "Edit(./.env)",
      "Edit(./.auth/**)",
      "Bash(cat .env*)",
      "Bash(cat .auth/*)",
      "Bash(less .env*)",
      "Bash(head .env*)",
      "Bash(tail .env*)",
      "Bash(git add -f *)",
      "Bash(git add --force *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)"
    ],
    "ask": [
      "Edit(**)",
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(find * -delete*)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git restore *)",
      "Bash(git checkout *)",
      "Bash(git clean *)",
      "Bash(git rm *)",
      "Bash(git branch -D *)",
      "Bash(git rebase *)",
      "Bash(git stash drop *)",
      "Bash(git config *)",
      "Bash(git filter-repo *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm update *)",
      "Bash(npm uninstall *)",
      "Bash(npm run signup *)",
      "Bash(npx cucumber-js --profile signup *)"
    ]
  }
}
